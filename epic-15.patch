+def test_metadata_creation_uses_typed_model() -> None:
+    service = MediaService()
+    metadata = service.create_metadata(
+        MediaPrepareRequest(type=MediaType.PHOTO, filename="sample.jpg"),
+        b"\xff\xd8\xffcontent",
+    )
+
