BERTELE2_APP_NAME=BerTele2
BERTELE2_ENV=production
BERTELE2_DEBUG=false
BERTELE2_API_PREFIX=/api/v1
BERTELE2_LOG_LEVEL=INFO
BERTELE2_DATABASE_URL=sqlite+aiosqlite:///./bertele2.db
BERTELE2_TELEGRAM_API_ID=
BERTELE2_TELEGRAM_API_HASH=
BERTELE2_TELEGRAM_SESSION_STRING=
BERTELE2_TELEGRAM_PHONE_NUMBER=
BERTELE2_TELEGRAM_BOT_TOKEN=
BERTELE2_REQUEST_TIMEOUT=30.0
GOWA_BASE_URL=http://localhost:8080
GOWA_API_KEY=
GOWA_WEBHOOK_SECRET=
GOWA_TIMEOUT_SECONDS=15.0
GOWA_MAX_RETRIES=3
GOWA_BACKOFF_FACTOR=1.5
GOWA_MAX_BACKOFF=30.0
GOWA_USE_MOCK_TRANSPORT=true

